# Site Configuration
NEXT_PUBLIC_SITE_URL=https://voon.fi

# Google Services
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Leave empty until you have the code from Google Search Console; the meta tag is omitted when unset
GOOGLE_SITE_VERIFICATION=

# Resend
RESEND_API_KEY=re_xxxxxxxx
# Must be an address on a domain verified in Resend, otherwise mail may go to spam
RESEND_FROM=Voon IQ <info@voon.fi>

# Social Media
NEXT_PUBLIC_TWITTER_HANDLE=@vooniq

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=info@voon.fi

# Optional: Analytics & Tracking
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Chatbot AI — NVIDIA API Catalog (build.nvidia.com), OpenAI-compatible. Required for the chatbot.
NVIDIA_API_KEY=
# Chat model id. Catalog models can be unavailable for your account (404/410) — test with your key first.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional comma-separated backups, tried if the first model fails or does not answer in time
NVIDIA_FALLBACK_MODELS=
# Reasoning models: thinking is turned off for chat. Set to true to allow it.
NVIDIA_ENABLE_THINKING=false
