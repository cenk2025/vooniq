# Site Configuration
NEXT_PUBLIC_SITE_URL=https://voon.fi

# Google Services
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Leave empty until you have the code from Google Search Console; the meta tag is omitted when unset
GOOGLE_SITE_VERIFICATION=

# Resend
RESEND_API_KEY=re_xxxxxxxx
# Must be an address on a domain verified in Resend, otherwise mail may go to spam
RESEND_FROM=Voon IQ <info@voon.fi>

# Social Media
NEXT_PUBLIC_TWITTER_HANDLE=@vooniq

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=info@voon.fi

# Optional: Analytics & Tracking
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Chatbot AI — NVIDIA API Catalog (build.nvidia.com), OpenAI-compatible.
# If NVIDIA_API_KEY is unset the chatbot falls back to OpenAI (OPENAI_API_KEY).
NVIDIA_API_KEY=
# Optional: any chat model id from build.nvidia.com (non-reasoning models work best for chat)
NVIDIA_MODEL=mistralai/mistral-large-2-instruct
