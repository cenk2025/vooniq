# Site Configuration
NEXT_PUBLIC_SITE_URL=https://voon.fi

# Google Services
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Leave empty until you have the code from Google Search Console; the meta tag is omitted when unset
GOOGLE_SITE_VERIFICATION=

# Resend
RESEND_API_KEY=re_xxxxxxxx
# Must be an address on a domain verified in Resend, otherwise mail may go to spam
RESEND_FROM=Voon IQ <info@voon.fi>

# Social Media
NEXT_PUBLIC_TWITTER_HANDLE=@vooniq

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=info@voon.fi

# Optional: Analytics & Tracking
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Chatbot AI — NVIDIA API Catalog (build.nvidia.com), OpenAI-compatible. Required for the chatbot.
NVIDIA_API_KEY=
# Optional: chat model id (non-reasoning models work best) and comma-separated backups
NVIDIA_MODEL=mistralai/mistral-large-2-instruct
NVIDIA_FALLBACK_MODELS=nvidia/llama-3.1-nemotron-70b-instruct,google/gemma-4-31b-it
